# Keep the Docker build context lean.
# Compose builds use the repo root as the context.

.git
.dockerignore

# Python caches
**/__pycache__
**/*.pyc
**/*.pyc.*
**/*.egg-info
**/.pytest_cache
**/.ruff_cache
.venv

# Node dependencies and build output
# The web image installs its own dependencies in the build stage.
**/node_modules
**/.next
apps/web/out

# Runtime data and local config
# Root-anchored: source directories such as apps/api/src/logs/
# and apps/api/src/voice2rx/services/storage/ remain included.
.env
/logs
/storage

# Deployment assets not referenced by Dockerfiles
/deploy/k8s
/deploy/certs

# Other local/build artifacts
**/.DS_Store
*.log

# Temporary files
/_to_delete