# ekascribe web (Next.js standalone)
FROM node:20-slim AS build
WORKDIR /repo
COPY package.json .npmrc ./
COPY apps/web/package.json apps/web/package.json
COPY packages/ui-lib/package.json packages/ui-lib/package.json
COPY packages/scribe-client-sdk packages/scribe-client-sdk
RUN npm install --no-audit --no-fund
COPY packages/ui-lib packages/ui-lib
COPY apps/web apps/web
# NEXT_PUBLIC_* are inlined at build time — pass your API host here
ARG NEXT_PUBLIC_API_HOST=http://varta.bharatai.gov.in/api
ARG NEXT_PUBLIC_WEB_HOST=http://varta.bharatai.gov.in
ARG NEXT_PUBLIC_EKA_HOST=http://varta.bharatai.gov.in/api
# ARG is not visible to RUN as env — bridge to ENV so Next.js inlines it at build
ENV NEXT_PUBLIC_API_HOST=${NEXT_PUBLIC_API_HOST}
ENV NEXT_PUBLIC_WEB_HOST=${NEXT_PUBLIC_WEB_HOST}
ENV NEXT_PUBLIC_EKA_HOST=${NEXT_PUBLIC_EKA_HOST}
RUN cd apps/web && npm run build

FROM node:20-slim

# In-image debugging toolkit -- see the same block in Dockerfile.api for why it
# is baked in rather than reached for with `kubectl debug`. Kept above the COPY
# layers so a code change does not re-run apt. No psql here: web talks to the
# API over HTTP, never to Postgres.
#
#   procps          ps, top, free, vmstat, kill
#   iproute2        ip, ss          net-tools     netstat, ifconfig
#   bind9-dnsutils  dig, nslookup   iputils-ping  ping
#   netcat-openbsd  nc              inetutils-telnet  telnet
RUN apt-get update && apt-get install -y --no-install-recommends \
    procps htop lsof less vim jq curl wget \
    iproute2 net-tools bind9-dnsutils iputils-ping netcat-openbsd inetutils-telnet \
    && rm -rf /var/lib/apt/lists/*

WORKDIR /app
ENV NODE_ENV=production
COPY --from=build /repo/apps/web/.next/standalone ./
COPY --from=build /repo/apps/web/.next/static ./apps/web/.next/static
COPY --from=build /repo/apps/web/public ./apps/web/public
EXPOSE 3000
CMD ["node", "apps/web/server.js"]
