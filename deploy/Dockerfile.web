# ekascribe web (Next.js standalone)
FROM node:20-slim AS build
WORKDIR /repo
COPY package.json .npmrc ./
COPY apps/web/package.json apps/web/package.json
COPY packages/ui-lib/package.json packages/ui-lib/package.json
COPY packages/scribe-client-sdk packages/scribe-client-sdk
RUN npm install --no-audit --no-fund
COPY packages/ui-lib packages/ui-lib
COPY apps/web apps/web
# NEXT_PUBLIC_* are inlined at build time — pass your API host here
ARG NEXT_PUBLIC_API_HOST=http://localhost:8000
ARG NEXT_PUBLIC_WEB_HOST=http://localhost:3000
# ARG is not visible to RUN as env — bridge to ENV so Next.js inlines it at build
ENV NEXT_PUBLIC_API_HOST=${NEXT_PUBLIC_API_HOST}
ENV NEXT_PUBLIC_WEB_HOST=${NEXT_PUBLIC_WEB_HOST}
RUN cd apps/web && npm run build

FROM node:20-slim
WORKDIR /app
ENV NODE_ENV=production
COPY --from=build /repo/apps/web/.next/standalone ./
COPY --from=build /repo/apps/web/.next/static ./apps/web/.next/static
COPY --from=build /repo/apps/web/public ./apps/web/public
EXPOSE 3000
CMD ["node", "apps/web/server.js"]
