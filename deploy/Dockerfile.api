# scribe API
FROM python:3.11-slim

# ffmpeg: pydub/VAD audio chunking; git: echo-sdk installs from git tag
#
# The rest is an in-image debugging toolkit. It is here on purpose: on a
# Gatekeeper-enforced cluster where we hold restricted RBAC, `kubectl debug`
# ephemeral containers are usually not available, so `kubectl exec` into the
# running pod is the only way in. Deliberately excludes tcpdump/strace -- they
# need NET_RAW/SYS_PTRACE, which the pod securityContext drops anyway.
#
#   procps            ps, top, free, vmstat, kill
#   iproute2          ip, ss          net-tools     netstat, ifconfig
#   bind9-dnsutils    dig, nslookup   iputils-ping  ping
#   netcat-openbsd    nc              inetutils-telnet  telnet
#   postgresql-client psql -- DATABASE_URL is the one backing service
#
# bind9-dnsutils/inetutils-telnet are the real packages; the familiar
# dnsutils/telnet names are bookworm transitional shims that go away in trixie,
# so naming the real ones survives a base-image rebase.
RUN apt-get update && apt-get install -y --no-install-recommends \
    ffmpeg git \
    procps htop lsof less vim jq curl wget \
    iproute2 net-tools bind9-dnsutils iputils-ping netcat-openbsd inetutils-telnet \
    postgresql-client \
    && rm -rf /var/lib/apt/lists/*

COPY --from=ghcr.io/astral-sh/uv:latest /uv /usr/local/bin/uv

WORKDIR /app
COPY pyproject.toml uv.lock ./
COPY packages/core ./packages/core
COPY apps/api ./apps/api
COPY apps/worker ./apps/worker
RUN uv sync --all-packages --frozen --no-dev
# belt-and-suspenders: keep the src dirs on sys.path at interpreter startup
RUN printf '/app/apps/api/src\n' > /app/.venv/lib/python3.11/site-packages/scribe_src.pth

COPY templates ./templates
COPY scripts ./scripts
COPY .env.example ./

ENV STORAGE_ROOT=/data/storage LOG_DIR=/data/logs
ENV PYTHONPATH=/app/apps/api/src
EXPOSE 8000
# Chunk coordination lives in Postgres (audio_chunks claims), so multiple
# uvicorn workers are safe in both execution modes. For multi-container
# scale-out use EXECUTION_MODE=worker + worker containers (durable queue).
ENV UVICORN_WORKERS=2
CMD ["sh", "-c", "PYTHONPATH=/app/apps/api/src /app/.venv/bin/uvicorn scribe.main:app --host 0.0.0.0 --port 8000 --workers ${UVICORN_WORKERS:-1}"]
