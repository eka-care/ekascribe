# ekascribe API
FROM python:3.11-slim

RUN apt-get update && apt-get install -y --no-install-recommends \
    ffmpeg git libpango-1.0-0 libpangocairo-1.0-0 libgdk-pixbuf-2.0-0 shared-mime-info \
    && rm -rf /var/lib/apt/lists/*

COPY --from=ghcr.io/astral-sh/uv:latest /uv /usr/local/bin/uv

WORKDIR /app
COPY pyproject.toml uv.lock ./
COPY packages/core ./packages/core
COPY apps/api ./apps/api
COPY apps/worker ./apps/worker
RUN uv sync --all-packages --frozen --no-dev

COPY prompts ./prompts
COPY templates ./templates
COPY scripts ./scripts
COPY .env.example ./

ENV STORAGE_ROOT=/data/storage LOG_DIR=/data/logs ECHO_PROMPT_DIR=/app/prompts
EXPOSE 8000
CMD ["uv", "run", "uvicorn", "scribe_api.main:app", "--host", "0.0.0.0", "--port", "8000", "--workers", "4"]
