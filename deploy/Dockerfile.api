# ekascribe API
FROM python:3.11-slim

RUN apt-get update && apt-get install -y --no-install-recommends \
    ffmpeg git libpango-1.0-0 libpangocairo-1.0-0 libgdk-pixbuf-2.0-0 shared-mime-info \
    && rm -rf /var/lib/apt/lists/*

COPY --from=ghcr.io/astral-sh/uv:latest /uv /usr/local/bin/uv

WORKDIR /app
COPY pyproject.toml uv.lock ./
COPY packages/core ./packages/core
COPY apps/api ./apps/api
COPY apps/worker ./apps/worker
RUN uv sync --all-packages --frozen --no-dev
# uv/hatchling editable does not expose every src package (logs, voice2rx...);
# a .pth adds the whole src dir to sys.path at interpreter startup (site.py).
RUN printf '/app/apps/api/src\n' > /app/.venv/lib/python3.11/site-packages/ekascribe_src.pth

COPY templates ./templates
COPY scripts ./scripts
COPY .env.example ./

ENV STORAGE_ROOT=/data/storage LOG_DIR=/data/logs
# src-layout packages (logs, voice2rx, scribe_api, medical_record) importable regardless of install mode
ENV PYTHONPATH=/app/apps/api/src
EXPOSE 8000
# EXECUTION_MODE=inprocess (default) runs the pipeline in-process — use 1 worker
# so background jobs + in-memory state stay in one process. For EXECUTION_MODE=worker,
# set UVICORN_WORKERS=4 (jobs run in the separate worker container).
ENV UVICORN_WORKERS=1
CMD ["sh", "-c", "PYTHONPATH=/app/apps/api/src /app/.venv/bin/uvicorn scribe.main:app --host 0.0.0.0 --port 8000 --workers ${UVICORN_WORKERS:-1}"]
