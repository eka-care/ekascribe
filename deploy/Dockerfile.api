# scribe API
FROM python:3.11-slim

# ffmpeg: pydub/VAD audio chunking; git: echo-sdk installs from git tag
RUN apt-get update && apt-get install -y --no-install-recommends \
    ffmpeg git \
    && rm -rf /var/lib/apt/lists/*

COPY --from=ghcr.io/astral-sh/uv:latest /uv /usr/local/bin/uv

WORKDIR /app
COPY pyproject.toml uv.lock ./
COPY packages/core ./packages/core
COPY apps/api ./apps/api
COPY apps/worker ./apps/worker
RUN uv sync --all-packages --frozen --no-dev
# belt-and-suspenders: keep the src dirs on sys.path at interpreter startup
RUN printf '/app/apps/api/src\n' > /app/.venv/lib/python3.11/site-packages/scribe_src.pth

COPY templates ./templates
COPY scripts ./scripts
COPY .env.example ./

ENV STORAGE_ROOT=/data/storage LOG_DIR=/data/logs
ENV PYTHONPATH=/app/apps/api/src
EXPOSE 8000
# EXECUTION_MODE=inprocess (default) runs the pipeline in-process — keep 1 uvicorn
# worker so background jobs + in-memory state stay in one process. For
# EXECUTION_MODE=worker, raise UVICORN_WORKERS (jobs run in the worker container).
ENV UVICORN_WORKERS=1
CMD ["sh", "-c", "PYTHONPATH=/app/apps/api/src /app/.venv/bin/uvicorn scribe.main:app --host 0.0.0.0 --port 8000 --workers ${UVICORN_WORKERS:-1}"]
