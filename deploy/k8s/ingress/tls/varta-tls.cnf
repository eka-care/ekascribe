# openssl config for the self-signed varta cert.
# Config-file form (not -addext) because macOS ships LibreSSL, which is
# inconsistent about -addext. SANs carry both spellings so the cert keeps
# working through the varta -> vaarta rename; browsers/clients validate
# against SAN, the CN is decorative.
[req]
distinguished_name = dn
x509_extensions    = ext
prompt             = no

[dn]
CN = vaarta.bharatai.gov.in
O  = Eka Care

[ext]
subjectAltName   = @alt_names
basicConstraints = CA:FALSE
keyUsage         = digitalSignature, keyEncipherment
extendedKeyUsage = serverAuth

[alt_names]
DNS.1 = vaarta.bharatai.gov.in
DNS.2 = varta.bharatai.gov.in
