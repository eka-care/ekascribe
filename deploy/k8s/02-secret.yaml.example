# ############################################################################
# TEMPLATE -- PLACEHOLDERS ONLY. DO NOT COMMIT REAL VALUES.
#
# The .example extension is deliberate: `kubectl apply -f deploy/k8s/` only
# reads .yaml/.yml/.json, so this file is skipped and cannot overwrite a real
# secret with the REPLACE_ME values below.
#
# Preferred: create this straight against the cluster so no credential ever
# touches the repo:
#
#   PGPASS="$(openssl rand -hex 24)"
#   kubectl create secret generic ekascribe-secrets -n eka-care \
#     --from-literal=POSTGRES_PASSWORD="$PGPASS" \
#     --from-literal=DATABASE_URL="postgresql://scribe:$PGPASS@ekascribe-postgres.eka-care.svc.cluster.local:5432/scribe" \
#     --from-literal=ECHO_PG_PASSWORD="$PGPASS" \
#     --from-literal=OPENWEBUI_API_KEY='...' \
#     --from-literal=UPLOAD_URL_SIGNING_SECRET="$(openssl rand -hex 32)"
#
# If you would rather use a file: copy it to a .yaml name, edit, and apply it
# explicitly. That copy is untracked -- keep it that way.
#   cp 02-secret.yaml.example 02-secret.yaml && $EDITOR 02-secret.yaml
#   kubectl apply -f deploy/k8s/02-secret.yaml
# ############################################################################
apiVersion: v1
kind: Secret
metadata:
  name: ekascribe-secrets
  namespace: eka-care
  labels:
    app.kubernetes.io/part-of: ekascribe
type: Opaque
stringData:
  # --- Database -----------------------------------------------------------
  # THESE THREE MUST CARRY THE SAME PASSWORD. There is no single DSN all the
  # clients read, so the one password appears three times:
  #
  #   POSTGRES_PASSWORD  what initdb sets on the `scribe` role
  #                      (05-postgres-statefulset.yaml reads this key)
  #   DATABASE_URL       psycopg pool + the procrastinate queue
  #   ECHO_PG_PASSWORD   asyncpg formulary client (host/port/db/user are in
  #                      01-configmap.yaml)
  #
  # A mismatch fails at different times and looks like three unrelated bugs:
  # the Job reports [FAIL] postgres, or the api is healthy but drug search
  # 500s. Generate once, paste three times.
  #
  # POSTGRES_PASSWORD only takes effect on FIRST boot, when initdb runs. On an
  # existing volume, changing it here changes nothing -- rotate with
  # `ALTER ROLE scribe PASSWORD '...'` inside the database, then update the
  # other two keys and restart the api.
  POSTGRES_PASSWORD: "REPLACE_ME"
  DATABASE_URL: "postgresql://scribe:REPLACE_ME@ekascribe-postgres.eka-care.svc.cluster.local:5432/scribe"
  ECHO_PG_PASSWORD: "REPLACE_ME"

  # --- Models -------------------------------------------------------------
  # Open WebUI (ECHO_DEFAULT_LLM_PROVIDER=openwebui in 01-configmap.yaml):
  OPENWEBUI_API_KEY: "REPLACE_ME"
  # Alternatives, if the provider in the ConfigMap changes:
  # ANTHROPIC_API_KEY: "REPLACE_ME"
  # SARVAM_API_KEY: "REPLACE_ME"
  # DEEPGRAM_API_KEY: "REPLACE_ME"
  # ECHO_LLM_API_KEY: "REPLACE_ME"        # openai_compatible provider only

  # --- Auth ---------------------------------------------------------------
  # Signs tokenized upload URLs. Generate with: openssl rand -hex 32
  UPLOAD_URL_SIGNING_SECRET: "REPLACE_ME"
  # If unset, every request authenticates as the dev identity. Set it to
  # require `Authorization: Bearer <token>`.
  # DEV_AUTH_TOKEN: "REPLACE_ME"

  # --- Webhooks -----------------------------------------------------------
  # WEBHOOK_HMAC_SECRET: "REPLACE_ME"

  # --- AWS (S3 blob storage) ----------------------------------------------
  # Leave these commented out when the cluster provides credentials via IRSA,
  # an instance role, or a node profile -- boto3's default credential chain
  # (scribe_core/storage.py) picks those up on its own, which is preferable to
  # long-lived static keys. Uncomment only if you have no other option.
  # AWS_ACCESS_KEY_ID: "REPLACE_ME"
  # AWS_SECRET_ACCESS_KEY: "REPLACE_ME"
