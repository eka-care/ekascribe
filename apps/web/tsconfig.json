{
  "compilerOptions": {
    "lib": [
      "dom",
      "dom.iterable",
      "esnext"
    ],
    "allowJs": true,
    "skipLibCheck": true,
    "strict": true,
    "noEmit": true,
    "esModuleInterop": true,
    "module": "esnext",
    "moduleResolution": "bundler",
    "resolveJsonModule": true,
    "isolatedModules": true,
    "jsx": "preserve",
    "incremental": true,
    "noUnusedLocals": true,
    "noUnusedParameters": true,
    "noFallthroughCasesInSwitch": true,
    "paths": {
      "@/*": [
        "./src/*"
      ],
      "@platform-impl": [
        "./src/platform/web"
      ],
      "@ui/*": [
        "../../packages/ui-lib/*"
      ],
      "@eka-ui/*": [
        "../../packages/ui-lib/src/eka-ui/*"
      ],
      "@/components/*": [
        "../../packages/ui-lib/src/shadcn-ui/components/*"
      ],
      "@/lib/*": [
        "../../packages/ui-lib/src/shadcn-ui/lib/*"
      ],
      "@/hooks/*": [
        "../../packages/ui-lib/src/shadcn-ui/hooks/*"
      ]
    },
    "target": "ES2017",
    "plugins": [
      {
        "name": "next"
      }
    ]
  },
  "include": [
    "**/*.ts",
    "**/*.tsx",
    ".next/types/**/*.ts",
    "next-env.d.ts",
    ".next-desktop/types/**/*.ts"
  ],
  "exclude": [
    "node_modules",
    "packages/ui-lib/vite.config.ts",
    "packages/ui-lib/eslint.config.js"
  ]
}
