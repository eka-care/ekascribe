# Environment baked into the embedded web app at build time and injected at runtime.
# Copy to electron.env and adjust for your deployment.
NEXT_PUBLIC_ENV = PROD
# Your scribe backend (defaults to http://localhost:8000 when unset)
# NEXT_PUBLIC_API_HOST = http://localhost:8000
# OIDC login provider for the desktop shell. Leave unset to skip the login
# screen and let the embedded web app handle auth (on-prem / dev-token mode).
# OIDC_BASE_URL = https://your-oidc-provider.example.com
