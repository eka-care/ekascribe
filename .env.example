# ekascribe — copy to .env and edit. scripts/setup.py generates this interactively.

# Deployment
ENV=local
SELF_URL=http://localhost:8000
WEB_URL=http://localhost:3000

# Pluggable backends (on-prem defaults)
STORAGE_BACKEND=local
DB_BACKEND=postgres
QUEUE_BACKEND=postgres
STATE_BACKEND=postgres

# Storage
STORAGE_ROOT=./storage
# S3_BUCKET=
# S3_ENDPOINT_URL=            # set for LocalStack/MinIO
AWS_REGION=ap-south-1

# Database
DATABASE_URL=postgresql://scribe:scribe@localhost:5432/scribe
# DYNAMODB_ENDPOINT_URL=

# Auth (v1: dev-token mode)
AUTH_MODE=dev
# DEV_AUTH_TOKEN=             # if unset, all requests authenticate as the dev identity
DEV_B_ID=onprem-workspace
DEV_UUID=00000000-0000-0000-0000-000000000001
DEV_OID=onprem-doctor-oid
AUTH_ISSUER=scribe.local
UPLOAD_URL_SIGNING_SECRET=change-me

# STT — Sarvam is the default; local whisper optional (phase 4)
ECHO_DEFAULT_TRANSCRIBER_PROVIDER=sarvam
# SARVAM_API_KEY=
# DEEPGRAM_API_KEY=

# LLM — any OpenAI-compatible endpoint (vLLM/Ollama or hosted)
ECHO_DEFAULT_LLM_PROVIDER=openai_compatible
ECHO_LLM_BASE_URL=http://localhost:11434/v1
# ECHO_LLM_API_KEY=
ECHO_LLM_MODEL=qwen3:14b

# Prompts
ECHO_PROMPT_PROVIDER=file
ECHO_PROMPT_DIR=./prompts

# Logging
LOG_DIR=./logs
LOG_LEVEL=INFO

# Feature flags (v1 defaults per plan decisions)
FEATURE_STREAMING=false
FEATURE_FHIR=false
FEATURE_PUBLISH_INTEGRATIONS=false
FEATURE_PATIENT_DIRECTORY=false
FEATURE_RECORDS_VAULT=false
FEATURE_PAYMENTS=false
FEATURE_DRUG_SEARCH=true

# Formulary (drug catalog search — optional; loaded by scripts/setup_medication_db.py)
# echo's PostgresClient reads these; point them at the same Postgres as DATABASE_URL
ECHO_PG_HOST=localhost
ECHO_PG_PORT=5432
ECHO_PG_DATABASE=scribe
ECHO_PG_USER=scribe
ECHO_PG_PASSWORD=scribe

# Webhooks (direct HTTP + HMAC)
# WEBHOOK_HMAC_SECRET=

DISCOVERY_SUPPORT_EMAIL=admin@example.com
