# ekascribe — copy to .env and edit. scripts/setup.py generates this interactively.

# Deployment
ENV=local
SELF_URL=http://localhost:8000
WEB_URL=http://localhost:3000

# Web hosts — inlined at build time; restart `make web` / rebuild web image after changes
NEXT_PUBLIC_API_HOST=http://localhost:8000
NEXT_PUBLIC_WEB_HOST=http://localhost:3000
# NEXT_PUBLIC_LOGIN_URL=   # external login page, if any

# Pluggable backends (on-prem defaults)
STORAGE_BACKEND=local

# Pipeline execution
#   inprocess = run the STT/stitch/finalize pipeline inside the api process as
#               background jobs — single container, no worker (default).
#   worker    = defer to Postgres/procrastinate; run worker container(s) too
#               (docker compose --profile worker up -d --scale worker=N).
# Chunk state lives in the audio_chunks Postgres table (claim-based), so BOTH
# modes are safe with multiple uvicorn processes and multiple containers.
EXECUTION_MODE=inprocess
# uvicorn processes for the api container. 2+ is safe in either mode; for
# multi-container deployments prefer EXECUTION_MODE=worker (durable queue).
UVICORN_WORKERS=2
# max concurrent in-process background jobs (inprocess mode only)
BACKGROUND_JOB_CONCURRENCY=4

# Storage
STORAGE_ROOT=./storage
# S3_BUCKET=
# S3_ENDPOINT_URL=            # set for LocalStack/MinIO
AWS_REGION=ap-south-1

# Database
DATABASE_URL=postgresql://scribe:scribe@127.0.0.1:5432/scribe

# Auth (v1: dev-token mode)
AUTH_MODE=dev
# DEV_AUTH_TOKEN=             # if unset, all requests authenticate as the dev identity
DEV_B_ID=onprem-workspace
DEV_UUID=00000000-0000-0000-0000-000000000001
DEV_OID=onprem-doctor-oid
AUTH_ISSUER=scribe.local
UPLOAD_URL_SIGNING_SECRET=change-me

# STT — pick ONE provider:
#   sarvam            : Sarvam Saarika API (needs SARVAM_API_KEY)
#   model_api         : self-hosted transcribe API (POST {url}?language=.. multipart file)
#   openai_compatible : any OpenAI-compatible /v1/audio/transcriptions server
#   gemini / ekacare  : hosted alternatives
ECHO_DEFAULT_TRANSCRIBER_PROVIDER=sarvam
# SARVAM_API_KEY=
# --- model_api example (self-deployed model service) ---
# ECHO_DEFAULT_TRANSCRIBER_PROVIDER=model_api
# MODEL_API_TRANSCRIBE_URL=http://ekascribe.orbi.orbi/transcribe
# # MODEL_API_AUTH_TOKEN=                        # optional Bearer token
# --- openai_compatible example (faster-whisper server / speaches / vLLM audio) ---
# ECHO_DEFAULT_TRANSCRIBER_PROVIDER=openai_compatible
# ECHO_TRANSCRIBER_BASE_URL=http://localhost:8001/v1
# OPENAI_COMPAT_STT_MODEL=whisper-1
# # ECHO_TRANSCRIBER_API_KEY=                    # optional Bearer token
# DEEPGRAM_API_KEY=

# LLM for note structuring — pick ONE provider:
#   openwebui         : Open WebUI instance fronting local models (Ollama/vLLM)
#   openai_compatible : any OpenAI-compatible endpoint (vLLM / Ollama / proxy)
#   anthropic         : Claude API (needs ANTHROPIC_API_KEY)
#   openai / gemini / bedrock : hosted alternatives
# --- openwebui example ---
# ECHO_DEFAULT_LLM_PROVIDER=openwebui
# OPENWEBUI_BASE_URL=http://localhost:3000      # plain instance URL; /api appended automatically
# OPENWEBUI_API_KEY=                            # Open WebUI -> Settings -> Account -> API keys
# ECHO_DEFAULT_LLM_MODEL=glm-52b                # an id from GET {base}/api/models
# OPENWEBUI_ENABLE_THINKING=false               # hybrid-reasoning models (GLM/Qwen3): no <think> preamble
# # OPENWEBUI_CHAT_TEMPLATE_KWARGS=             # optional raw JSON forwarded as chat_template_kwargs
# OPENWEBUI_CA_BUNDLE=/certs/<file>.pem         # endpoint behind a private CA: pem in deploy/certs/
# OPENWEBUI_DISABLE_TOOLS=true                  # TEMP: serving stack rejects tools (vLLM without --enable-auto-tool-choice); note degrades to plain text
# # OPENWEBUI_VERIFY_SSL=false                  # or disable TLS verification (dev/testing ONLY)
# --- openai_compatible example ---
# ECHO_DEFAULT_LLM_PROVIDER=openai_compatible
# ECHO_LLM_BASE_URL=http://localhost:11434/v1   # openai_compatible only
# # ECHO_LLM_API_KEY=                           # openai_compatible only (if endpoint needs one)
# ECHO_DEFAULT_LLM_MODEL=qwen3:14b
# --- anthropic example ---
ECHO_DEFAULT_LLM_PROVIDER=anthropic
ECHO_DEFAULT_LLM_MODEL=claude-sonnet-4-20250514
ANTHROPIC_API_KEY=<paste your api key here>

# Logging
LOG_DIR=./logs
LOG_LEVEL=INFO

# echo's PostgresClient reads these; point them at the same Postgres as DATABASE_URL
ECHO_PG_HOST=127.0.0.1
ECHO_PG_PORT=5432
ECHO_PG_DATABASE=scribe
ECHO_PG_USER=scribe
ECHO_PG_PASSWORD=scribe

DISCOVERY_SUPPORT_EMAIL=admin@example.com
